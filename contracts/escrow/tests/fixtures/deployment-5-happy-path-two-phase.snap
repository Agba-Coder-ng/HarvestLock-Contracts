# #125 snapshot: HANDOFF.md Deployment 5 scenario 1 — the two-phase-funding
# happy path, with every amount as recorded from the live instance.
snapshot = deployment-5-happy-path-two-phase
provenance = derived from HANDOFF.md "Verified on testnet", Deployment 5 scenario 1,
   contract CB5MR3IYQ6R4QTFMTXTBFG4WSCZTJ3QTND6GMBSASGORPQSD3VKYCTCW (WASM
   3351e0de…): 1,000,000,000 stroops, 15%/20% split, `lock` moving exactly
   350,000,000, advances of 150,000,000 and 200,000,000, a 650,000,000
   `fund_remainder`, and a final cooperative total of exactly 1,000,000,000.
   Call order and amounts are HANDOFF.md's; the windows are not recorded there,
   so they use the app-level defaults. No transaction XDR was captured.
total_amount = 1000000000
advance1_bps = 1500
advance2_bps = 2000
claim_window_secs = 604800
remainder_window_secs = 604800
delivery_window_secs = 1036800
contracted_quantity = 1000
grade_price_bps = 10000,9000,7500
buyer_mint = 1000000000

step = lock => ok
check = contract_balance 350000000
check = buyer_balance 650000000
step = release_advance_1 => ok
step = claim_advance_1 => ok
check = coop_balance 150000000
step = mark_checkpoint => ok
step = release_advance_2 => ok
step = claim_advance_2 => ok
check = coop_balance 350000000
step = ready_for_delivery => ok
step = fund_remainder => ok
check = contract_balance 650000000
check = buyer_balance 0
step = confirm_delivery 1000 0 => ok
check = settlement_bps 10000
check = status Delivered
step = settle => ok
# recorded final tally: cooperative 150M + 200M + 650M = 1,000,000,000, buyer and
# contract both at 0, status Settled.
check = coop_balance 1000000000
check = buyer_balance 0
check = contract_balance 0
check = status Settled
