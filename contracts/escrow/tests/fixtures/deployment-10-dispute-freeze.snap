# #125 snapshot: HANDOFF.md Deployment 10 — dispute freeze and timed resume.
snapshot = deployment-10-dispute-freeze
provenance = derived from HANDOFF.md "Verified on testnet", Deployment 10, contract
   CCHQLA3LZXWXWJJR75TWFM4POBPA673VIWJX4YWSAHUZEWUSXSF6HJBO: native XLM as the
   settlement token, remainder_window_secs 120, `lock` moving a real 300,000,000
   deposit, the cooperative calling `flag_dispute`, a subsequent `release_advance_1`
   rejected on-chain with InvalidState, and after the real 120-second
   dispute_deadline `expire_dispute_window` — called by the deployer account, not a
   party — restoring status to exactly Locked with dispute_pre_status cleared back
   to Draft. Amounts and rejections as recorded from testnet; no transaction XDR
   was captured.
total_amount = 1000000000
advance1_bps = 1500
advance2_bps = 1500
claim_window_secs = 604800
remainder_window_secs = 120
delivery_window_secs = 1036800
contracted_quantity = 1000
grade_price_bps = 10000,9000,7500
buyer_mint = 1000000000

step = lock => ok
# recorded: a real 300,000,000 transfer, not a fixture.
check = contract_balance 300000000
step = flag_dispute cooperative => ok
check = status Disputed
check = dispute_pre_status Locked
# recorded live: the freeze blocks the next state change with InvalidState.
step = release_advance_1 => err(InvalidState)
step = advance 121
step = expire_dispute_window => ok
# recorded: status restored to exactly Locked, dispute_pre_status back to Draft.
check = status Locked
check = dispute_pre_status Draft
check = contract_balance 300000000
step = release_advance_1 => ok
check = status Advance1Released
